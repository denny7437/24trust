# Скопируйте в .env.local (разработка) или .env (Docker) и заполните.

# Адрес сайта без слеша на конце: canonical, sitemap, Open Graph, ссылка на согласие в заявке
NEXT_PUBLIC_SITE_URL=https://example.ru

# Яндекс Метрика. Пусто — аналитика выключена, баннер cookie сводится к уведомлению с кнопкой «Понятно».
# Значение подставляется при сборке: после изменения пересоберите проект.
NEXT_PUBLIC_YM_ID=

# Сборка (npm run build) останавливается, пока на сайте остались [заглушки], пустые реквизиты
# или адрес сайта localhost. Для локальной проверки черновика раскомментируйте строку в .env.local.
# На сервере и в боевой сборке не задавайте.
# ALLOW_PLACEHOLDERS=1

# Порт приложения на хосте для docker compose (слушает только 127.0.0.1, снаружи — через nginx).
# Поменяйте, если 3000 на сервере занят другим проектом.
# SITE_PORT=3000

# --- Заявки ---------------------------------------------------------------
# Папка для файла заявок leads.jsonl (по умолчанию ./data). На сервере — отдельный том с бэкапом.
LEADS_DIR=./data
# off — не писать заявки в файл (только если настроен вебхук или почта)
LEADS_FILE=on

# Вебхук в CRM / n8n на российских серверах: POST с JSON заявки
LEAD_WEBHOOK_URL=
# Если задан — уходит в заголовке Authorization: Bearer <secret>
LEAD_WEBHOOK_SECRET=

# Уведомление на почту через SMTP российского сервиса (например, Яндекс 360: smtp.yandex.ru, порт 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFY_TO=
